    # ---- small helpers ----
    def _set_classes(self, on):
        for v in self.cls_vars.values():
            v.set(on)

    def _placeholder(self, text):
        self.fig.clear()
        self.fig.text(0.5, 0.5, text, ha="center", va="center", fontsize=12, color="#666666")
        self.canvas.draw_idle()

    def _tz_now(self):
        if self.loc and self.loc[0] == self.loc_var.get().strip() and len(self.loc) > 4 and self.loc[4]:
            return self.loc[4][0]
        return None

    def use_now(self):
        tz = self._tz_now()
        t = datetime.now(tz) if tz else datetime.now().astimezone()
        self.date_var.set(t.strftime("%Y-%m-%d"))
        self.time_var.set(t.strftime("%H:%M"))
        self.utc_var.set(False)

    def choose_catalog(self):
        p = filedialog.askopenfilename(title="Select hygdata_v41.csv (the HYG star catalogue)")
        if p:
            self.catalog_path = p
            self.stars = None
            self.status.set(f"Will use the catalogue file {os.path.basename(p)}.")

    # ---- background work ----
    def _start(self, target, *args):
        threading.Thread(target=target, args=args, daemon=True).start()

    def _poll(self):
        try:
            while True:
                kind, payload = self.q.get_nowait()
                if kind == "progress":
                    self.status.set(payload)
                elif kind == "loc":
                    self.loc = payload
                    self.loc_info.set(f"{payload[3]}\nlat {payload[1]:.4f}°, lon {payload[2]:.4f}°"
                                      + (f", time zone {payload[4][1]}" if payload[4] else
                                         ", time zone unknown (set the UTC offset)"))
                    self.status.set("Location found.")
                elif kind == "error":
                    self._set_busy(False)
                    self.status.set("Failed.")
                    messagebox.showerror("Visible stars", payload)
                elif kind == "done":
                    self._set_busy(False)
                    self.show_result(payload)
        except queue.Empty:
            pass
        self.after(100, self._poll)

    def _set_busy(self, busy):
        self.busy = busy
        self.find_btn.configure(state="disabled" if busy else "normal")
        self.config(cursor="watch" if busy else "")

    def _resolve(self, text):
        """(text, lat, lon, label, (tzinfo, tzname) or None) - runs in a worker thread."""
        if self.loc and self.loc[0] == text:
            return self.loc
        lat, lon, label = resolve_location(text)
        return (text, lat, lon, label, find_timezone(lat, lon))

    def lookup_location(self):
        text = self.loc_var.get().strip()
        if not text:
            messagebox.showinfo("Location", "Type a place name or 'latitude, longitude' first.")
            return
        self.status.set("Looking up the location…")

        def work():
            try:
                self.q.put(("loc", self._resolve(text)))
            except Exception as e:
                self.q.put(("error", str(e)))
        self._start(work)

    # ---- the search ----
    def find(self):
        if self.busy:
            return
        text = self.loc_var.get().strip()
        if not text:
            messagebox.showinfo("Location", "Enter a location first.")
            return
        try:
            count = int(self.count_var.get())
            if not 1 <= count <= 100:
                raise ValueError
        except ValueError:
            messagebox.showerror("Number of stars", "Enter a whole number from 1 to 100.")
            return
        classes = [c for c in CLASSES if self.cls_vars[c].get()]
        if not classes:
            messagebox.showinfo("Spectral classes", "Tick at least one spectral class.")
            return
        try:
            min_alt = float(self.minalt_var.get())
            limit = float(self.limmag_var.get())
            if not 0 <= min_alt < 90:
                raise ValueError
        except ValueError:
            messagebox.showerror("Visibility options", "Minimum altitude must be 0–89 and the faintest "
                                 "magnitude a number such as 6.0.")
            return
        p = dict(text=text, count=count, classes=classes, min_alt=min_alt, limit=limit,
                 rank="highest" if self.rank_var.get().startswith("highest") else "brightest",
                 ignore_sky=self.ignore_var.get(), date=self.date_var.get().strip(),
                 time=self.time_var.get().strip(), is_utc=self.utc_var.get(),
                 offset=self.offset_var.get().strip())
        self._set_busy(True)
        self.status.set("Working…")
        self._start(self._work, p)

    def _work(self, p):
        try:
            loc = self._resolve(p["text"])
            self.q.put(("loc", loc))
            _, lat, lon, label, tzinfo = loc
            if p["is_utc"]:
                tz, tzname = timezone.utc, "UTC"
            elif tzinfo:
                tz, tzname = tzinfo
            else:
                try:
                    h = float(p["offset"])
                    if not -14 <= h <= 14:
                        raise ValueError
                except ValueError:
                    raise ValueError("The time zone of this place could not be found automatically (install "
                                     "timezonefinder, or enter the UTC offset in hours, e.g. -5).")
                tz, tzname = timezone(timedelta(hours=h)), f"UTC{h:+g}"
            when_text = (p["date"] + " " + p["time"]).strip()
            if not p["date"] and not p["time"]:
                when_text = "now"
            elif not p["time"]:
                when_text = p["date"]                       # a date alone means 22:00 local
            elif not p["date"]:
                raise ValueError("Enter a date as well as a time (or press 'Now').")
            when_utc = parse_when(when_text, tz)
            if self.stars is None:
                self.stars = load_catalog(self.catalog_path, False,
                                          lambda s: self.q.put(("progress", s)))
            self.q.put(("progress", "Computing positions…"))
            alt, az, sun_alt = compute_positions(self.stars, lat, lon, when_utc)
            state, sky_lim = sky_state(sun_alt)
            limit, notes = p["limit"], []
            if not p["ignore_sky"]:
                if sky_lim is None:
                    chosen = {c: [] for c in p["classes"]}
                    avail = {c: 0 for c in p["classes"]}
                    notes.append("No stars are visible to the naked eye in daylight. Choose a time after "
                                 "sunset, or tick 'Ignore daylight / twilight'.")
                    limit = None
                elif sky_lim < limit:
                    notes.append(f"Twilight: limiting magnitude reduced from {limit:g} to about {sky_lim:g} "
                                 "(rough estimate).")
                    limit = sky_lim
            if limit is not None:
                chosen, avail = select_stars(self.stars, alt, az, p["classes"], p["count"], limit,
                                             p["min_alt"], p["rank"])
            self.q.put(("done", dict(p=p, label=label, lat=lat, lon=lon, tzname=tzname, tz=tz,
                                     when_utc=when_utc, sun_alt=sun_alt, state=state, limit=limit,
                                     notes=notes, chosen=chosen, avail=avail)))
        except Exception as e:
            self.q.put(("error", str(e)))

    # ---- showing results ----
    def show_result(self, r):
        self.result = r
        p = r["p"]
        local = r["when_utc"].astimezone(r["tz"])
        lines = [f"{r['label']}",
                 f"{local:%Y-%m-%d %H:%M} {r['tzname']}  ({r['when_utc']:%Y-%m-%d %H:%M} UTC)    "
                 f"Sun altitude {r['sun_alt']:+.1f}° - {r['state']}"]
        if r["limit"] is not None:
            lines.append(f"Showing stars at least {p['min_alt']:g}° above the horizon and brighter than "
                         f"V = {r['limit']:g}, {'brightest' if p['rank'] == 'brightest' else 'highest'} first.")
        lines += r["notes"]
        self.info.set("\n".join(lines))

        self.tree.delete(*self.tree.get_children())
        total = 0
        for c, rows in r["chosen"].items():
            if not rows:
                self.tree.insert("", "end", values=(c, "", "none visible", "", "", "", "", "", ""), tags=(c,))
            for n, s in enumerate(rows, 1):
                total += 1
                self.tree.insert("", "end", tags=(c,), values=(
                    c, n, s["name"], s["con"], s["spect"], f"{s['mag']:.2f}", f"{s['alt']:.0f}°",
                    f"{s['az']:.0f}°", compass(s["az"])))
            short = p["count"] - len(rows)
            if rows and short > 0:
                self.tree.insert("", "end", tags=(c,), values=(
                    c, "", f"(only {len(rows)} qualify - {r['avail'][c]} in the sky)", "", "", "", "", "", ""))
        self.save_btn.configure(state="normal" if total else "disabled")
        self.draw_chart(r)
        self.status.set(f"{total} stars listed.")

    def draw_chart(self, r):
        self.fig.clear()
        ax = self.fig.add_subplot(111, projection="polar")
        ax.set_theta_zero_location("N")
        ax.set_theta_direction(1)                         # E to the left, as when looking up at the sky
        ax.set_rlim(0, 90)
        ax.set_rticks([30, 60, 90])
        ax.set_yticklabels(["60°", "30°", "0°"], fontsize=8, color="#777777")
        ax.set_xticks(np.radians([0, 90, 180, 270]))
        ax.set_xticklabels(["N", "E", "S", "W"], fontsize=12, fontweight="bold")
        ax.grid(alpha=0.35)
        min_alt = r["p"]["min_alt"]
        th = np.linspace(0, 2 * np.pi, 200)
        ax.plot(th, np.full_like(th, 90 - min_alt), "--", color="#999999", lw=0.8)
        stars = [dict(s, cls=c) for c, rows in r["chosen"].items() for s in rows]
        label_them = len(stars) <= 45
        for c in CLASSES:
            pts = [s for s in stars if s["cls"] == c]
            if not pts:
                continue
            ax.scatter([np.radians(s["az"]) for s in pts], [90 - s["alt"] for s in pts],
                       s=[max(14, 150 * 10 ** (-0.18 * (s["mag"] + 1.5))) for s in pts], color=CLASS_COLOR[c],
                       edgecolor="k", linewidth=0.4, zorder=3, label=f"{c} ({len(pts)})")
            if label_them:
                for s in pts:
                    ax.annotate(s["name"], (np.radians(s["az"]), 90 - s["alt"]), xytext=(5, 4),
                                textcoords="offset points", fontsize=7.5, zorder=4)
        if stars:
            ax.legend(loc="upper right", bbox_to_anchor=(1.18, 1.08), fontsize=8, title="Class", title_fontsize=8)
        local = r["when_utc"].astimezone(r["tz"])
        ax.set_title(f"Sky at {local:%Y-%m-%d %H:%M} {r['tzname']}  (looking up, dashed ring = minimum altitude)",
                     fontsize=10, pad=18)
        self.canvas.draw_idle()

    def save(self):
        if not self.result:
            return
        p = filedialog.asksaveasfilename(title="Save the star list", defaultextension=".csv",
                                         initialfile="visible_stars.csv")
        if not p:
            return
        try:
            save_csv(p, self.result["chosen"])
        except Exception as e:
            messagebox.showerror("Save failed", str(e))
            return
        self.status.set(f"Saved {p}")


def main():
    app = StarApp()
    app.lift()
    app.attributes("-topmost", True)                    # come to the front (Spyder can hide the window)
    app.after(400, lambda: app.attributes("-topmost", False))
    app.focus_force()
    app.mainloop()


if __name__ == "__main__":
    main()
