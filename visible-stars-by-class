SPECT_RE = re.compile(r"^\s*(?:sd|d|g|c)?([OBAFGKM])(\d+(?:\.\d+)?)?")
COMPASS = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]


# ----------------------------------------------------------------------------------------------
# Star catalogue
# ----------------------------------------------------------------------------------------------
def spectral_class(spect):
    m = SPECT_RE.match(spect or "")
    return m.group(1) if m else None


def star_name(r):
    proper = (r.get("proper") or "").strip()
    con = (r.get("con") or "").strip()
    if proper:
        return proper
    bayer = (r.get("bayer") or "").strip()
    if bayer and con:
        base, _, num = bayer.partition("-")
        letter = GREEK.get(base, base)
        return f"{letter}{num} {con}"
    flam = (r.get("flam") or "").strip()
    if flam and con:
        return f"{flam} {con}"
    for key, label in (("hr", "HR"), ("hd", "HD"), ("hip", "HIP")):
        v = (r.get(key) or "").strip()
        if v:
            return f"{label} {v}"
    return "unnamed"


def _read_rows(path):
    with open(path, newline="", encoding="utf-8") as fh:
        for r in csv.DictReader(fh):
            yield r


def _filter_rows(rows):
    """Keep stars brighter than CACHE_MAG with a spectral class O-M. Close companions that only have a
    catalogue number (e.g. one component of Capella) are named after the named star beside them, and
    entries whose type is only that of a distant companion ('comp') are dropped."""
    raw = []
    for r in rows:
        try:
            mag = float(r["mag"])
            ra, dec = float(r["ra"]), float(r["dec"])
        except (KeyError, ValueError):
            continue
        if r.get("id") == "0" or (r.get("proper") or "") == "Sol" or mag > CACHE_MAG:
            continue
        named = bool((r.get("proper") or "").strip() or (r.get("bayer") or "").strip()
                     or (r.get("flam") or "").strip())
        raw.append(dict(name=star_name(r), named=named, con=(r.get("con") or "").strip(),
                        spect=(r.get("spect") or "").strip(), mag=mag, ra_h=ra, dec=dec))
    if raw:
        ra = np.array([x["ra_h"] for x in raw]) * 15.0
        dec = np.array([x["dec"] for x in raw])
        named_idx = np.array([i for i, x in enumerate(raw) if x["named"]], dtype=int)
        for i, x in enumerate(raw):
            if x["named"] or named_idx.size == 0:
                continue
            d_dec = np.abs(dec[named_idx] - dec[i])
            d_ra = np.abs(ra[named_idx] - ra[i]) * math.cos(math.radians(dec[i]))
            near = np.flatnonzero((d_dec < 30 / 3600.0) & (d_ra < 30 / 3600.0))
            if near.size:
                x["name"] = f"{raw[named_idx[near[0]]]['name']} (comp.)"
    out = []
    for x in raw:
        cls = spectral_class(x["spect"])
        if cls is None or "comp" in x["spect"]:
            continue
        out.append(dict(name=x["name"], con=x["con"], spect=x["spect"], cls=cls, mag=x["mag"],
                        ra_h=x["ra_h"], dec=x["dec"]))
    return out


def _download(url, dest, progress=None):
    req = urllib.request.Request(url, headers={"User-Agent": "visible-stars-by-class/1.0"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        total = int(resp.headers.get("Content-Length") or 0)
        got = 0
        with open(dest, "wb") as fh:
            while True:
                chunk = resp.read(1 << 18)
                if not chunk:
                    break
                fh.write(chunk)
                got += len(chunk)
                if total and progress:
                    progress(f"Downloading the star catalogue (one time only)… {100 * got / total:3.0f}%")


def load_catalog(path=None, refresh=False, progress=None):
    """List of star dicts (V <= 7, spectral class O-M). Builds the small cache on first use."""
    if path:
        return _filter_rows(_read_rows(path))
    if CACHE_FILE.exists() and not refresh:
        with open(CACHE_FILE, newline="", encoding="utf-8") as fh:
            return [dict(r, mag=float(r["mag"]), ra_h=float(r["ra_h"]), dec=float(r["dec"]))
                    for r in csv.DictReader(fh)]
    if progress:
        progress("First run: fetching the HYG star catalogue (one time, about 34 MB)…")
    tmpdir = tempfile.mkdtemp(prefix="hyg_")
    tmp = os.path.join(tmpdir, "hyg.csv")
    try:
        _download(HYG_URL, tmp, progress)
        stars = _filter_rows(_read_rows(tmp))
    except Exception as e:
        raise RuntimeError(f"Could not download the star catalogue ({e}).\n\nDownload it in a browser from\n"
                           f"{HYG_URL}\nthen use 'Catalogue file…' in this program to select it.")
    finally:
        try:
            os.remove(tmp)
            os.rmdir(tmpdir)
        except OSError:
            pass
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    with open(CACHE_FILE, "w", newline="", encoding="utf-8") as fh:
        w = csv.DictWriter(fh, fieldnames=["name", "con", "spect", "cls", "mag", "ra_h", "dec"])
        w.writeheader()
        w.writerows(stars)
    return stars


