LATLON_RE = re.compile(r"^\s*([+-]?\d+(?:\.\d+)?)\s*[,; ]\s*([+-]?\d+(?:\.\d+)?)\s*$")


def resolve_location(text):
    """(lat, lon, label) from 'lat, lon' or a place name (needs geopy and an internet connection)."""
    m = LATLON_RE.match(text)
    if m:
        lat, lon = float(m.group(1)), float(m.group(2))
        if not (-90 <= lat <= 90 and -180 <= lon <= 180):
            raise ValueError("Latitude must be between -90 and 90 and longitude between -180 and 180.")
        return lat, lon, f"{lat:.4f}°, {lon:.4f}°"
    try:
        from geopy.geocoders import Nominatim
    except ImportError:
        raise ValueError("To look up place names, install geopy (pip install geopy), or type "
                         "coordinates instead, for example   36.01, -84.27   (negative longitude = west).")
    try:
        loc = Nominatim(user_agent="visible-stars-by-class", timeout=10).geocode(text)
    except Exception as e:
        raise ValueError(f"The place-name lookup failed ({type(e).__name__}). Check your internet "
                         "connection or type coordinates, for example   36.01, -84.27")
    if loc is None:
        raise ValueError(f"Could not find '{text}'. Try adding the state or country, or type coordinates.")
    return float(loc.latitude), float(loc.longitude), loc.address


def find_timezone(lat, lon):
    """(tzinfo, name) from timezonefinder, or None if it is not installed or has no answer."""
    try:
        from timezonefinder import TimezoneFinder
        from zoneinfo import ZoneInfo
        name = TimezoneFinder().timezone_at(lat=lat, lng=lon)
        if name:
            return ZoneInfo(name), name
    except Exception:
        pass
    return None


TIME_FORMATS = ["%Y-%m-%d %H:%M", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %I:%M %p", "%Y-%m-%d %I:%M%p",
                "%m/%d/%Y %H:%M", "%m/%d/%Y %I:%M %p", "%m/%d/%Y %I:%M%p", "%Y-%m-%dT%H:%M",
                "%Y-%m-%d", "%m/%d/%Y"]


def parse_when(text, tz):
    """Aware UTC datetime from local-time text ('now', '2026-11-03 21:30', '11/3/2026 9:30 PM', …).
    Adding 'UTC' at the end means the time is already UTC. A date alone means 22:00 local."""
    s = text.strip()
    if s.lower() in ("", "now"):
        return datetime.now(timezone.utc)
    use_tz = tz
    if s.upper().endswith("UTC"):
        s, use_tz = s[:-3].strip(), timezone.utc
    elif s.upper().endswith("Z"):
        s, use_tz = s[:-1].strip(), timezone.utc
    for fmt in TIME_FORMATS:
        try:
            dt = datetime.strptime(s, fmt)
        except ValueError:
            continue
        if "%H" not in fmt and "%I" not in fmt:
            dt = dt.replace(hour=22)
        return dt.replace(tzinfo=use_tz).astimezone(timezone.utc)
    raise ValueError("Could not read that date and time. Examples:  2026-11-03 21:30   or   "
                     "11/03/2026 9:30 PM   or   now")


# ----------------------------------------------------------------------------------------------
# Astronomy
# ----------------------------------------------------------------------------------------------
def sky_state(sun_alt):
    """(description, rough naked-eye limiting magnitude or None for 'no stars visible')."""
    if sun_alt > 0:
        return "daytime (Sun above the horizon)", None
    if sun_alt > -6:
        return "civil twilight", 1.5
    if sun_alt > -12:
        return "nautical twilight", 3.5
    if sun_alt > -18:
        return "astronomical twilight", 5.0
    return "dark sky", 99.0


def compute_positions(stars, lat, lon, when_utc, height_m=0.0):
    """Altitude and azimuth (degrees) of every star, plus the Sun's altitude."""
    from astropy import units as u
    from astropy.coordinates import AltAz, EarthLocation, SkyCoord, get_sun
    from astropy.time import Time
    try:
        from astropy.utils import iers
        iers.conf.auto_download = False       # no network needed; sub-arcsecond Earth-rotation data are
        iers.conf.auto_max_age = None         # irrelevant for finding naked-eye stars
        iers.conf.iers_degraded_accuracy = "ignore"
    except Exception:
        pass
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")       # e.g. astropy's "IERS predictive values are old" notice
        loc = EarthLocation.from_geodetic(lon=lon * u.deg, lat=lat * u.deg, height=height_m * u.m)
        t = Time(when_utc)
        frame = AltAz(obstime=t, location=loc)
        ra = np.array([s["ra_h"] for s in stars]) * 15.0
        dec = np.array([s["dec"] for s in stars])
        aa = SkyCoord(ra=ra * u.deg, dec=dec * u.deg, frame="icrs").transform_to(frame)
        sun = get_sun(t).transform_to(frame)
        return aa.alt.deg, aa.az.deg, float(sun.alt.deg)


def select_stars(stars, alt, az, classes, count, limit_mag, min_alt, rank="brightest"):
    """{class: [star dict + alt/az]} with up to `count` visible stars per class, plus availability counts."""
    chosen, available = {}, {}
    for c in classes:
        idx = [i for i, s in enumerate(stars) if s["cls"] == c and s["mag"] <= limit_mag and alt[i] >= min_alt]
        available[c] = len(idx)
        key = (lambda i: stars[i]["mag"]) if rank == "brightest" else (lambda i: -alt[i])
        idx.sort(key=key)
        chosen[c] = [dict(stars[i], alt=float(alt[i]), az=float(az[i])) for i in idx[:count]]
    return chosen, available


def compass(az):
    return COMPASS[int((az % 360) / 22.5 + 0.5) % 16]


# ----------------------------------------------------------------------------------------------
# Output
# ----------------------------------------------------------------------------------------------
def save_csv(path, chosen):
    with open(path, "w", newline="", encoding="utf-8") as fh:
        w = csv.writer(fh)
        w.writerow(["class", "star", "constellation", "spectral_type", "vmag", "altitude_deg", "azimuth_deg",
                    "direction"])
        for c, rows in chosen.items():
            for s in rows:
                w.writerow([c, s["name"], s["con"], s["spect"], f"{s['mag']:.2f}", f"{s['alt']:.1f}",
                            f"{s['az']:.1f}", compass(s["az"])])




